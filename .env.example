# Leave this unset when using setup.ps1/start.ps1. The bundled dependency is
# resolved from node_modules/sysu-anything automatically.
# SYSU_ANYTHING_CLI=C:\path\to\sysu-anything.js
SYSU_ANYTHING_NODE=node
PRIVATE_SYSU_SERVICE_URL=https://jwxt.sysu.edu.cn/jwxt/
PRIVATE_SYSU_SINGLE_USER_FALLBACK=0

# Chrome/Edge debugging port used by the local Yiwen authorization window.
YIWEN_CHROME_DEBUG_PORT=9222
YIWEN_AUTO_IMPORT_CHROME=1
YIWEN_KEEPALIVE_SECONDS=300

# Public materials index cache
FRESHMAN_MATERIALS_CACHE_TTL_SECONDS=86400

# Optional external RAG service
EXTERNAL_RAG_ENABLED=0
EXTERNAL_RAG_BASE_URL=http://127.0.0.1:8000
EXTERNAL_RAG_TIMEOUT_SECONDS=8
EXTERNAL_RAG_TOPK=5
